{
  "name": "tax-lien-insight-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Production backend for Tax Lien Insight (Node/TypeScript/PostgreSQL). Deployed independently from the TanStack Start frontend.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "admin:bootstrap": "tsx src/db/bootstrap.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "nodemailer": "^10.0.1",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0",
    "wrangler": "^4.130.0"
  }
}
