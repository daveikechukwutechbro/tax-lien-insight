# ---------------------------------------------------------------------------
# Tax Lien Insight — Backend environment configuration
# Copy to `.env` and fill in. NEVER commit real credentials.
# ---------------------------------------------------------------------------

# Application
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:8787
PORT=8787
# development | staging | production
ENVIRONMENT=development

# PostgreSQL (Neon). Use the POOLED hostname (contains "-pooler") for the
# deployed serverless backend; use the direct hostname for migrations/CLI.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/taxlien
# Direct connection for migrations (bypasses pooler)
DATABASE_DIRECT_URL=postgres://postgres:postgres@localhost:5432/taxlien

# Auth
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars
SESSION_COOKIE_NAME=tli_session
SESSION_TTL_SECONDS=86400
# Comma-separated origins allowed to receive cookies cross-site (optional)
COOKIE_DOMAIN=

# Email
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=no-reply@taxlieninsight.example
EMAIL_REPLY_TO=

# USDC / Blockchain
USDC_NETWORK=base
USDC_TOKEN_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_CONFIRMATION_THRESHOLD=12
BLOCKCHAIN_RPC_URL=
BLOCKCHAIN_WEBHOOK_SECRET=

# Settlement destinations (server-side only, never hardcoded in source).
# Platform revenue and auction/tax-sale proceeds are legally distinct and
# must route to distinct, contractually authorized destinations.
USDC_SETTLEMENT_ADDRESS_PLATFORM=
USDC_SETTLEMENT_ADDRESS_PROCEEDS=

# Object storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_PUBLIC_BASE_URL=

# Jobs / cron
CRON_SECRET=

# Secure one-time admin bootstrap (disable after first use)
ADMIN_BOOTSTRAP_SECRET=
ADMIN_BOOTSTRAP_EMAIL=admin@taxlieninsight.example

# Rate limiting (requests per window)
RATE_LIMIT_LOGIN=10
RATE_LIMIT_REGISTER=5
RATE_LIMIT_BID=30
